// NOURISH — PostgreSQL schema
// Supports Ethiopia-first deployment with global extensibility

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum PregnancyStatus {
  NOT_APPLICABLE
  NOT_PREGNANT
  PREGNANT
  LACTATING
}

enum MealPlanStatus {
  DRAFT
  PENDING_OPTIMIZATION
  OPTIMIZED
  FAILED
  ARCHIVED
}

enum Currency {
  ETB
  USD
  EUR
}

enum DataSourceType {
  FOOD_COMPOSITION
  NUTRIENT_REFERENCE
  PRICE_SURVEY
  USER_REPORTED
  IMPORTED
  CALCULATED
}

// ─── User & Household ────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  households Household[]

  @@index([email])
}

model Household {
  id        String   @id @default(cuid())
  name      String
  userId    String
  regionId  String?
  currency  Currency @default(ETB)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  region          Region?           @relation(fields: [regionId], references: [id])
  members         HouseholdMember[]
  pantryItems     PantryItem[]
  dailyBudgets    DailyBudget[]
  mealPlans       MealPlan[]
  nutrientHistory NutrientHistory[]

  @@index([userId])
  @@index([regionId])
}

model HouseholdMember {
  id                  String          @id @default(cuid())
  householdId         String
  name                String
  dateOfBirth         DateTime
  sex                 Sex             @default(UNSPECIFIED)
  pregnancyStatus     PregnancyStatus @default(NOT_APPLICABLE)
  allergies           String[]        @default([])
  dietaryRestrictions String[]        @default([])
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// ─── Geography ─────────────────────────────────────────────────────────────────

model Region {
  id             String   @id @default(cuid())
  code           String   @unique
  nameEn         String
  nameAm         String?
  countryCode    String   @db.VarChar(3)
  parentRegionId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parentRegion Region?     @relation("RegionHierarchy", fields: [parentRegionId], references: [id])
  childRegions Region[]    @relation("RegionHierarchy")
  households   Household[]
  foodPrices   FoodPrice[]

  @@index([countryCode])
  @@index([parentRegionId])
}

// ─── Food & Nutrients ──────────────────────────────────────────────────────────

model Food {
  id            String    @id @default(cuid())
  canonicalId   String    @unique
  nameEn        String
  nameAm        String?
  foodGroup     String?
  defaultUnit   String
  ediblePortion Float? // fraction 0–1 if applicable
  sourceName    String?
  sourceUrl     String?
  sourceVersion String?
  importedAt    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  nutrients     FoodNutrient[]
  prices        FoodPrice[]
  pantryItems   PantryItem[]
  mealPlanItems MealPlanItem[]

  @@index([canonicalId])
  @@index([foodGroup])
}

model NutrientDefinition {
  id        String   @id @default(cuid())
  code      String   @unique // energy, protein, iron, calcium, vitamin_a, folate, zinc
  nameEn    String
  nameAm    String?
  unit      String // kcal, g, mg, mcg
  category  String? // macro, mineral, vitamin
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foodNutrients     FoodNutrient[]
  nutrientHistory   NutrientHistory[]
  mealPlanNutrients MealPlanNutrientCoverage[]

  @@index([code])
}

model FoodNutrient {
  id            String    @id @default(cuid())
  foodId        String
  nutrientId    String
  amountPer100g Float
  sourceName    String?
  sourceUrl     String?
  sourceVersion String?
  importedAt    DateTime?

  // Optional quality metadata preserved from the source dataset.
  // Examples:
  // "oa" = data originating outside Africa
  // "bracketed" = value shown in square brackets in EFCT.
  sourceFlag  String?
  qualityNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  food     Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient NutrientDefinition @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@unique([foodId, nutrientId])
  @@index([foodId])
  @@index([nutrientId])
}

// ─── Pricing ───────────────────────────────────────────────────────────────────

model FoodPrice {
  id         String         @id @default(cuid())
  foodId     String
  regionId   String
  price      Decimal        @db.Decimal(12, 4)
  unit       String
  currency   Currency       @default(ETB)
  sourceName String?
  sourceUrl  String?
  sourceType DataSourceType @default(IMPORTED)
  observedAt DateTime
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([foodId, regionId, observedAt])
  @@index([regionId, observedAt])
}

// ─── Pantry & Budget ───────────────────────────────────────────────────────────

model PantryItem {
  id          String   @id @default(cuid())
  householdId String
  foodId      String
  quantity    Float
  unit        String
  notes       String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  food      Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([foodId])
}

model DailyBudget {
  id          String   @id @default(cuid())
  householdId String
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  currency    Currency @default(ETB)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealPlans MealPlan[]

  @@unique([householdId, date])
  @@index([householdId, date])
}

// ─── Meal Plans ─────────────────────────────────────────────────────────────────

model MealPlan {
  id               String         @id @default(cuid())
  householdId      String
  dailyBudgetId    String?
  planDate         DateTime       @db.Date
  status           MealPlanStatus @default(PENDING_OPTIMIZATION)
  totalCost        Decimal?       @db.Decimal(12, 2)
  currency         Currency       @default(ETB)
  optimizerVersion String?
  calculationMeta  Json?
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  household        Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dailyBudget      DailyBudget?               @relation(fields: [dailyBudgetId], references: [id])
  items            MealPlanItem[]
  nutrientCoverage MealPlanNutrientCoverage[]
  nutrientHistory  NutrientHistory[]

  @@index([householdId, planDate])
  @@index([status])
}

model MealPlanItem {
  id         String   @id @default(cuid())
  mealPlanId String
  foodId     String
  quantity   Float
  unit       String
  unitCost   Decimal  @db.Decimal(12, 4)
  totalCost  Decimal  @db.Decimal(12, 2)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  food     Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@index([foodId])
}

model MealPlanNutrientCoverage {
  id            String   @id @default(cuid())
  mealPlanId    String
  nutrientId    String
  targetAmount  Float
  actualAmount  Float
  coverageRatio Float // actual / target, capped for display
  unit          String
  isGap         Boolean  @default(false)
  createdAt     DateTime @default(now())

  mealPlan MealPlan           @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  nutrient NutrientDefinition @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, nutrientId])
  @@index([mealPlanId])
}

// ─── Nutrient History (Nutrient Memory) ────────────────────────────────────────

model NutrientHistory {
  id            String         @id @default(cuid())
  householdId   String
  nutrientId    String
  recordDate    DateTime       @db.Date
  targetAmount  Float
  actualAmount  Float
  coverageRatio Float
  unit          String
  sourcePlanId  String?
  sourceType    DataSourceType @default(CALCULATED)
  createdAt     DateTime       @default(now())

  household  Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  nutrient   NutrientDefinition @relation(fields: [nutrientId], references: [id], onDelete: Cascade)
  sourcePlan MealPlan?          @relation(fields: [sourcePlanId], references: [id])

  @@index([householdId, recordDate])
  @@index([nutrientId, recordDate])
  @@index([sourcePlanId])
}
